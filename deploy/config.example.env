# Event Index server configuration.
#
# Copy to /etc/eventindex/deploy.env on the server and edit. This file holds
# no secrets; the secrets are separate files in /etc/eventindex/ (see
# README.md, "Secrets").

# Hostnames. DNS A/AAAA records for all three point at the server.
DOMAIN=eventindex.space
API_HOST=api.eventindex.space
RELAY_HOST=relay.eventindex.space

# Address Let's Encrypt writes to about certificates.
ACME_EMAIL=ops@example.org
# 1 to use Let's Encrypt's staging service (untrusted certificates, no rate limits).
ACME_STAGING=0

# The code: a git URL and the tag or commit to run.
REPO_URL=https://github.com/Event-Index/index.git
REPO_REF=main

# Pinned tools. Hashes are the official SHA-256 of each release file.
NODE_VERSION=22.23.3
NODE_SHA256_X64=df450af89261115ef9f9e3830c3eeb2cc9213b63c720b1af623cb5dcbe2e02de
NODE_SHA256_ARM64=a44aeb94849a299b22df10b9e622ec2f605c2183501bc40590705131de7c740f
STRFRY_VERSION=1.1.3
STRFRY_COMMIT=16c00df04e264f4d68db5e10a48127f015c7824b
LITESTREAM_VERSION=0.5.17
LITESTREAM_SHA256_X64=a191a0928884d1820fab1f866ede1d0d5811c323d0587bf863a43481a82a7668
LITESTREAM_SHA256_ARM64=7d34ed3356844fe3dd127462b9f4ea7e79ef14679eadf2fed6c737dcb797358e

# The S3-compatible bucket for backups (any provider). The keys go in
# /etc/eventindex/bucket.env, not here.
#   DigitalOcean Spaces: endpoint https://<region>.digitaloceanspaces.com, region <region>
#   Other providers (IONOS, ...): the S3 endpoint and region of the bucket's
#   location, as the provider's console shows them.
BUCKET_ENDPOINT=https://nyc3.digitaloceanspaces.com
BUCKET_REGION=nyc3
BUCKET_NAME=eventindex-backups
# Key prefix inside the bucket, so one bucket can hold several servers.
BUCKET_PREFIX=eventindex
# How long backups are kept. A deleted calendar key leaves the backups
# when its last snapshot is this old.
BACKUP_RETENTION=168h
RELAY_EXPORT_KEEP_DAYS=30

# Size of the swap file the setup creates when the server has none.
SWAP_SIZE=2G

# Local ports (bound to 127.0.0.1 only).
API_PORT=8080
RELAY_PORT=7777

# Whether the indexer publishes to relays other than its own. Off until the
# operator turns it on. With it on, calendar profiles, relay lists, calendars
# and upcoming events go to GENERAL_RELAYS, and the directory list (kinds
# 39998 and 39999) to GENERAL_RELAYS and LIST_RELAYS. Comma-separated wss://
# addresses; LIST_RELAYS is empty unless set.
PUBLISH_TO_GENERAL_RELAYS=0
GENERAL_RELAYS=wss://nos.lol,wss://relay.primal.net,wss://relay.damus.io
LIST_RELAYS=
