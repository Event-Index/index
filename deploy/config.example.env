# Event Index server configuration.
#
# Copy to /etc/eventindex/deploy.env on the server and edit. This file holds
# no secrets; the secrets are separate files in /etc/eventindex/ (see
# README.md, "Secrets").

# Hostnames. DNS A/AAAA records for all three point at the server.
DOMAIN=eventindex.space
API_HOST=api.eventindex.space
RELAY_HOST=relay.eventindex.space

# Address Let's Encrypt writes to about certificates.
ACME_EMAIL=ops@example.org
# 1 to use Let's Encrypt's staging service (untrusted certificates, no rate limits).
ACME_STAGING=0

# The code: a git URL and the tag or commit to run.
REPO_URL=https://github.com/Event-Index/index.git
REPO_REF=main

# Pinned tools. Hashes are the official SHA-256 of each release file.
NODE_VERSION=22.23.4
NODE_SHA256_X64=1805bcd35e6815559bd2eb97db438d3fdb0eb3a5e6a977b7c1badca76337e9ce
NODE_SHA256_ARM64=6287aa46b6c375d816e63ae66d024fbbfd70404825aabdfdf898a970871d2f4b
STRFRY_VERSION=1.1.3
STRFRY_COMMIT=16c00df04e264f4d68db5e10a48127f015c7824b
LITESTREAM_VERSION=0.5.17
LITESTREAM_SHA256_X64=a191a0928884d1820fab1f866ede1d0d5811c323d0587bf863a43481a82a7668
LITESTREAM_SHA256_ARM64=7d34ed3356844fe3dd127462b9f4ea7e79ef14679eadf2fed6c737dcb797358e

# The S3-compatible bucket for backups (any provider). The keys go in
# /etc/eventindex/bucket.env, not here.
#   DigitalOcean Spaces: endpoint https://<region>.digitaloceanspaces.com, region <region>
#   Other providers (IONOS, ...): the S3 endpoint and region of the bucket's
#   location, as the provider's console shows them.
BUCKET_ENDPOINT=https://nyc3.digitaloceanspaces.com
BUCKET_REGION=nyc3
BUCKET_NAME=eventindex-backups
# Key prefix inside the bucket, so one bucket can hold several servers.
BUCKET_PREFIX=eventindex
# How long backups are kept.
BACKUP_RETENTION=168h
RELAY_EXPORT_KEEP_DAYS=30

# Size of the swap file the setup creates when the server has none.
SWAP_SIZE=2G

# Local ports (bound to 127.0.0.1 only).
API_PORT=8080
RELAY_PORT=7777

# Whether the indexer publishes beyond its own relay. Off until the operator
# turns it on; when it goes on, what the relay already holds is sent once.
# Four sets of relays, each a comma-separated list of wss:// addresses (empty
# for the default, "none" for no relays):
#   SEARCH_RELAYS   relays that index events for search: the index key's
#                   profile and relay list, the directory and the event
#                   items (default: none)
#   LIST_RELAYS     relays that take only list kinds: the directory and the
#                   event items (kinds 39998 and 39999) (default: none)
#   PROFILE_RELAYS  the index key's profile, relay list and follow list
#                   (default: wss://purplepag.es)
#   GENERAL_RELAYS  the index key's profile, relay list and follow list, and
#                   the events of organizers the index publishes as when they
#                   name no relay of their own, rate-limited
# The index key's own profile and relay list go to PROFILE_RELAYS and
# GENERAL_RELAYS even while this is off. The directory goes to SEARCH_RELAYS
# and LIST_RELAYS only once PUBLISH_DIRECTORY_OUTSIDE is 1 as well; until then
# it stays on the index's relay.
PUBLISH_TO_GENERAL_RELAYS=0
PUBLISH_DIRECTORY_OUTSIDE=0
# The coordinate of the directory's list header, signed by a maintainer:
# 39998:<maintainer's hex key>:event-calendars. The index key signs only the
# entries, as the list's curator (spec/directory.md). Empty: a header under
# the index key.
DIRECTORY_HEADER=
SEARCH_RELAYS=
LIST_RELAYS=
PROFILE_RELAYS=
GENERAL_RELAYS=wss://nos.lol,wss://relay.primal.net,wss://relay.damus.io

# Discovery reads each Luma city page filed as an aggregator every six hours
# and files the named public calendars of its events. Empty for the default:
#   DISCOVERY_PER_RUN  new calendars one run of one page may take (25)
#   DISCOVERY_PER_DAY  calendars discovery files in a day (300)
DISCOVERY_PER_RUN=
DISCOVERY_PER_DAY=

# The coverage report (eventindex-admin coverage): another publisher's
# upcoming NIP-52 events compared with the index's, read-only, daily at 13:00
# UTC while COVERAGE_PUBKEY (hex) is set. COVERAGE_RELAY defaults to the first
# of SEARCH_RELAYS. Reports are kept in the data directory's coverage/.
COVERAGE_PUBKEY=
COVERAGE_RELAY=
# 1 to have the index's relay also take the calendars, events and deletions
# of organizers the index publishes as, through their own signer (kinds
# 31922, 31923, 31924 and 5; spec/relay.md). 0: their events go to their own
# relays only.
RELAY_HOSTS_CLAIMANTS=1

# 1 to list events as items of the Events list (spec/event-items.md): the
# index key publishes one per upcoming event of each mirrored calendar, to
# the index's relay and, while PUBLISH_DIRECTORY_OUTSIDE is 1, the search and
# list relays, paced. EVENTS_HEADER is that list's header, signed by a maintainer:
# 39998:<maintainer's hex key>:events. Required when EVENT_ITEMS is 1.
EVENT_ITEMS=0
EVENTS_HEADER=
# At most this many items live at once, for a first look (empty: no cap).
EVENT_ITEMS_MAX=
# Only the events of the calendars this file lists are items (empty: every
# mirrored calendar's), such as seeds/item-calendars.json; a relative path is
# the app's. A calendar taken off the list has its items withdrawn.
EVENT_ITEMS_CALENDARS=

# 1 to read every public NIP-52 event (kinds 31922, 31923) by kind and list
# each publisher in the directory (spec/indexer-rules.md § 14). The events are
# kept as signed and served as records; the index never signs or sends them.
# INGEST_SEARCH_RELAYS are read with their include:spam extension (default:
# SEARCH_RELAYS); INGEST_RELAYS plainly (default: damus, nos.lol, primal,
# formstr).
INGEST_NOSTR=0
INGEST_RELAYS=
INGEST_SEARCH_RELAYS=
# 1 to send the directory entries of publishers listed that way to the list
# and search relays as well; until then they stay on the index's relay.
PUBLISH_NOSTR_ENTRIES_OUTSIDE=0
# 1 to read each upcoming Meetup event's page, once and again when its feed
# changes the event, for the venue and status its schema.org data shows:
# what robots.txt allows, at most one request to meetup.com every 5 seconds
# (feeds included), paused on a 403 or 429 and stopped after five in a row
# (eventindex-admin meetup-pages resume).
MEETUP_PAGES=0
