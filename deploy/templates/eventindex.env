# Settings for the indexer and the API (rendered from /etc/eventindex/deploy.env).
EVENTINDEX_DATA_DIR=${DATA_DIR}
EVENTINDEX_INDEX_DB=${DATA_DIR}/index.db
EVENTINDEX_VAULT_DB=${DATA_DIR}/vault.db
EVENTINDEX_INDEX_KEY_FILE=${ETC}/index-key.nsec
EVENTINDEX_CALENDAR_SECRET_FILE=${ETC}/calendar-key.secret
EVENTINDEX_RELAY_URL=ws://127.0.0.1:${RELAY_PORT}
EVENTINDEX_RELAY_ALLOWLIST=${DATA_DIR}/relay-allowlist.json
EVENTINDEX_PUBLIC_RELAY=wss://${RELAY_HOST}
EVENTINDEX_API_PORT=${API_PORT}
EVENTINDEX_API_BASE=https://${API_HOST}/api/1.0
EVENTINDEX_DOMAIN=${DOMAIN}
EVENTINDEX_PUBLISH_TO_GENERAL_RELAYS=${PUBLISH_TO_GENERAL_RELAYS}
EVENTINDEX_GENERAL_RELAYS=${GENERAL_RELAYS}
EVENTINDEX_LIST_RELAYS=${LIST_RELAYS}
EVENTINDEX_SEARCH_RELAYS=${SEARCH_RELAYS}
EVENTINDEX_PROFILE_RELAYS=${PROFILE_RELAYS}
